# ==========================================
# Docker Ignore configuration for Frontend
# ==========================================

# Ignore git metadata
.git
.gitignore

# Ignore local node packages
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local build output
dist/
build/
.vite/

# Ignore local environments files containing secrets
.env
.env.*
!.env.example

# Ignore IDE and editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Ignore Docker files and project documentation
Dockerfile
README.md
